<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Local diagnostic only. Enumerate installed apps to locate vendor-renamed GMS/Play packages; no INTERNET permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Android 11+ package visibility: only the packages needed for this local test. -->
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.android.vending" />
        <package android:name="com.android.chrome" />
        <package android:name="org.microg.gms" />
        <intent>
            <action android:name="com.google.android.gms.fido.fido2.privileged.START" />
        </intent>
        <intent>
            <action android:name="com.google.android.gms.fido.fido2.regular.START" />
        </intent>
    </queries>

    <application
        android:label="Huawei FIDO2 诊断"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".DiagnosticActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
